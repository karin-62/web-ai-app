{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ai-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f948441c-e030-4585-aa99-dc673fe2d7c3","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b9e00be2bd9c48c7a15006367ceba870" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
